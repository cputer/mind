// ===========================================================================
// MIC3 v0x04 DECLARED-PREFIX MIRROR — pure MIND, executed as a native ELF.
//
// WHAT THIS IS. An additive, pure-MIND re-implementation of the draft MIC3
// `0x04` core codec covering the COMPLETE body: the header (magic, version
// byte, required-surface bits), the string table, the schema section, function
// declarations with their signature descriptors, module next_id, the export
// list, the instruction list including nested function bodies, the four
// reserved compatibility counts, and module semantic value rows. It reads an
// artifact named on argv, decodes the body, re-emits it through its own
// canonical encoder, and compares the re-emitted bytes against the consumed
// input bytes. Exit 0 means the body decoded AND re-encoded byte for byte AND
// the artifact contained nothing past it.
//
// WHAT THIS IS NOT. Wire acceptance is NOT full semantic validity, and exit 0
// must not be read as the latter. The module-scope ValueId bound is checked
// below because it is a framing invariant of this body reader. These other
// reference predicates remain separately named outstanding obligations, not
// rules this program has checked:
//
//   * verify_canonical_metadata — parameter descriptors/names, local definition
//     coverage, and each function's semantic-row scope/budget remain outside
//     this mirror. The parameter arity, return-presence, return ValueId, return
//     descriptor, and FnDef-name-to-declaration identity checks are implemented
//     below.
//   * the "carries no semantic authority" condition, which refuses a body whose
//     bundle is empty and whose instructions carry no metadata.
//   * string-table minimality: the reference rebuilds the table from the
//     strings actually referenced, so a body carrying an entry nothing names is
//     noncanonical. The mirror re-emits the table it was given.
//
// A body this program exits 0 on is therefore WIRE-CANONICAL and has passed the
// module-scope core ValueId bound — it decoded, its canonical re-encoding is
// byte-identical to the bytes consumed, and nothing stronger is claimed.
// Content past the body is still refused (20).
// A complete `0x04` artifact from the reference encoder is read through the
// module rows and exits 0 when no trailing bytes remain; this still does not
// certify the semantic predicates listed above.
//
// DECLARED NARROWINGS vs the reference decoder, stated rather than hidden:
//   * ULEB128 values are admitted up to 2^62-1. The reference admits the full
//     u64 range. A larger value is refused as a limit breach (exit 17), never
//     wrapped. This WAS unreachable while every field was a count bounded by
//     the remaining byte span. It no longer is: `next_id` is the first field
//     the grammar does not bound that way, so a body declaring next_id above
//     2^62-1 is refused here (exit 17, or exit 14 past nine bytes) while the
//     reference admits it and re-emits it. That is a real, constructible
//     divergence, stated rather than hidden. The reference's own
//     next_id == usize::MAX refusal is pre-empted by these limits.
//   * The re-emission buffer is bounded at 65536 bytes; a longer prefix is
//     refused as a limit breach (exit 17).
//   * The input buffer is bounded at MAX_MIC3_INPUT + 2; anything longer is
//     refused as oversize (exit 17) without being decoded.
//
//   * The string index table and the schema table are bounded by the admitted
//     prefix, so a declared count larger than that prefix is refused as a limit
//     breach (exit 17) before either table is allocated.
//
// The allocation-budget mirror follows the reference formula
// min(128 MiB, 1 MiB + 32 * input_bytes) with the reference's own charges for
// string-table slots (32 each), string bytes (1 each), schema headers (256
// each), schema fields (192 each), type descriptors (160 each) and the
// eight-bytes-per-referenced-byte owned-projection charge. The reference's
// final whole-body "canonical re-emission" charge is NOT applied here. The
// mirror performs the byte comparison, but does not model that separate
// reference allocation charge.
// Semantic descriptors use the separate reference limit of 2^40 elements:
// fixed arrays multiply, dynamic arrays add one, RecordRef costs one, and every
// nested shape is checked before its parent. Schema fields share one cumulative
// scope; function signatures share the future module-value scope. Module value
// rows are decoded and re-emitted in the complete-body path; semantic
// validation of those rows remains outside this mirror's wire-only contract.
//
// SUBSET NOTE. Written in the tail-recursive, immutable, i64-only subset the
// frozen pure-MIND native compiler accepts: no `while`, no mutation, no structs,
// no aggregate returns. Multi-value results travel through an explicit state
// record in raw memory.
//
// USAGE
//   ./mirror <artifact>            decode + checked re-emission, exit = verdict
//   ./mirror <artifact> --dump     on success also write the re-emitted prefix
//                                  bytes to stdout, so a caller can compare them
//                                  against the input itself rather than trusting
//                                  this program's own equality claim
//
// EXIT CODES (one distinct named cause per refusal class)
//    0 OK_EXACT             prefix decoded, re-emitted byte-identically, no remainder
//    2 USAGE                no artifact path on argv
//    3 OPEN_FAILED          open(2) failed
//   10 TRUNCATED            input ends inside a field the grammar requires
//   11 BAD_MAGIC            first four bytes are not "MIC3"
//   12 WRONG_VERSION        version byte is not 0x04
//   13 NON_MINIMAL_ULEB     terminating ULEB byte is 0 at a nonzero index
//   14 OVERLONG_ULEB        ULEB continuation runs past the admitted length
//   15 UNKNOWN_SURFACE      required-surface bits outside KNOWN_SURFACE_BITS
//   16 STD_SURFACE_REQUIRED REQUIRED_STD_SURFACE set: refused by the core codec
//   17 OVERSIZE             input, prefix or value exceeds a declared bound
//   18 REEMIT_MISMATCH      canonical re-emission differs from the consumed bytes
//   19 STRING_TABLE_ORDER   string table is not strictly sorted by UTF-8 bytes
//   20 REMAINDER_REFUSED    prefix verified; content beyond the declared subset
//   21 BAD_UTF8             string-table entry is not valid UTF-8
//   22 BUDGET_EXHAUSTED     decoded-allocation budget breached
//   23 INDEX_OUT_OF_BOUNDS  a string or schema reference names no entry
//   24 DESCRIPTOR_DEPTH     type descriptor nests past the declared limit
//   25 UNKNOWN_TYPE_TAG     type or scalar tag outside the core codec
//   26 SCHEMA_ORDER         schema identities are not strictly sorted
//   27 BAD_IDENTITY         identity component empty or path-like
//   28 DUPLICATE_FIELD      a schema declares the same field name twice
//   29 UNKNOWN_FUNCTION_KIND function kind tag outside local/external/intrinsic
//   30 FUNCTION_ORDER       function identities are not strictly sorted
//   31 RESERVED_OWNER       intrinsic owner rule violated in either direction
//   32 BAD_OPTIONAL_TAG     an explicit 0/1 presence tag is neither
//   33 DESCRIPTOR_ELEMENTS  one semantic descriptor or its cumulative scope
//                           exceeds the reference's 2^40 element bound
//   34 INTRINSIC_CONTRACT   reserved intrinsic has no exact registered
//                           name or `(i64...) -> i64` signature
//   35 EXPORT_ORDER         export references are not strictly increasing
//   36 INSTR_DEPTH          instruction nesting reaches the reference's 256
//   37 UNKNOWN_OPCODE       opcode outside the core scalar subset
//   38 RESERVED_NONZERO     a reserved compatibility count is not zero
//   39 VALUE_ROW_ORDER      semantic value rows not strictly sorted by ValueId
//   40 BAD_BINOP            binary operator tag outside the core set
//   41 VALUE_ID_BOUND       module next_id is below a module-scope ValueId
//   42 RETURN_SIGNATURE      FnDef return metadata disagrees with its declaration
//   43 FUNCTION_IDENTITY     FnDef name disagrees with its resolved declaration
//   44 PARAMETER_ARITY        FnDef parameter count disagrees with declaration
//   45 NONLOCAL_FUNCTION_BODY FnDef references an external/intrinsic declaration
//   46 DUPLICATE_FUNCTION    two FnDef bodies define the same declaration
//                            that cannot carry a local body
// ===========================================================================

// ---- declared bounds ------------------------------------------------------

pub fn mv_max_input() -> i64 {
    10485760
}

pub fn mv_max_prefix() -> i64 {
    65536
}

pub fn mv_max_uleb_value() -> i64 {
    4611686018427387903
}

pub fn mv_budget_base() -> i64 {
    1048576
}

pub fn mv_budget_cap() -> i64 {
    134217728
}

pub fn mv_max_descriptor_elements() -> i64 {
    1099511627776
}

// ---- state record ---------------------------------------------------------
// st+0 cursor   st+8 value   st+16 status   st+24 remaining allocation budget
// st+32 last descriptor elements   st+40 schema cumulative elements
// st+48 module-value/function-signature cumulative elements
// st+56 current intrinsic-signature mismatch flag
// st+64 module-scope exclusive ValueId bound
// st+72 whether mv_vid currently records module-scope IDs
// st+80 return ValueId under validation
// st+88 declared return descriptor start
// st+96 declared return descriptor end
// st+104 whether the return row was found
// st+112 whether return-row validation is active
// st+120 optional return ValueId presence tag
// st+128+depth*8 saved FnDef return presence (nested optionals reuse st+120)
// st+2176+depth*8 saved FnDef name string index
// st+4256+depth*8 saved FnDef parameter count
// st+6400+depth*8 saved FnDef return ValueId (nested functions have their own)

pub fn mv_st_cursor(st: i64) -> i64 {
    __mind_load_i64(st + 0)
}

pub fn mv_st_value(st: i64) -> i64 {
    __mind_load_i64(st + 8)
}

pub fn mv_st_status(st: i64) -> i64 {
    __mind_load_i64(st + 16)
}

pub fn mv_fail(st: i64, code: i64) -> i64 {
    __mind_store_i64(st + 16, code);
    code
}

pub fn mv_st_budget(st: i64) -> i64 {
    __mind_load_i64(st + 24)
}

pub fn mv_st_elements(st: i64) -> i64 {
    __mind_load_i64(st + 32)
}

pub fn mv_bytes_equal(buf: i64, left: i64, right: i64, n: i64) -> i64 {
    if n <= 0 {
        return 1;
    }
    if __mind_load_i8(buf + left) != __mind_load_i8(buf + right) {
        return 0;
    }
    mv_bytes_equal(buf, left + 1, right + 1, n - 1)
}

// Add the last descriptor's semantic element cost to one reference-owned
// scope. `slot` is st+40 for all schema fields, or st+48 for module values plus
// all function parameters/returns. Subtract before adding so no admitted input
// can overflow i64 while checking the smaller 2^40 contract.
pub fn mv_add_elements(st: i64, slot: i64) -> i64 {
    let item: i64 = mv_st_elements(st);
    let total: i64 = __mind_load_i64(st + slot);
    if item > mv_max_descriptor_elements() - total {
        return mv_fail(st, 33);
    }
    __mind_store_i64(st + slot, total + item);
    0
}

// Deduct `amount` from the reference decoder's remaining allocation budget.
// Returns 0, or 22 with the status set when the budget is breached. Charges are
// applied in the reference's order so that a body which exhausts the budget
// does so at the same point here.
pub fn mv_charge(st: i64, amount: i64) -> i64 {
    let left: i64 = __mind_load_i64(st + 24) - amount;
    if left < 0 {
        return mv_fail(st, 22);
    }
    __mind_store_i64(st + 24, left);
    0
}

// ---- input ----------------------------------------------------------------

// read(2) may return short; loop until `want` or EOF. Returns bytes read.
pub fn mv_read_all(fd: i64, buf: i64, want: i64, got: i64) -> i64 {
    if got >= want {
        return got;
    }
    let n: i64 = __mind_read(fd, buf + got, want - got, 0 - 1);
    if n <= 0 {
        return got;
    }
    mv_read_all(fd, buf, want, got + n)
}

// ---- ULEB128 --------------------------------------------------------------

// Decode a minimal ULEB128 at `pos`. On success stores the next cursor at st+0
// and the value at st+8 and returns 0; otherwise stores and returns the cause.
//
// `mul` is 128^idx, carried instead of shifting so the accumulation is a plain
// multiply-add. idx is capped at 8, i.e. at most nine bytes / 63 value bits,
// which is the declared narrowing against the reference's ten-byte u64 form.
pub fn mv_uleb(buf: i64, len: i64, pos: i64, idx: i64, acc: i64, mul: i64, st: i64) -> i64 {
    if pos >= len {
        return mv_fail(st, 10);
    }
    if idx > 8 {
        return mv_fail(st, 14);
    }
    let b: i64 = __mind_load_i8(buf + pos);
    let acc2: i64 = acc + (b & 127) * mul;
    if acc2 < 0 {
        return mv_fail(st, 17);
    }
    if acc2 > mv_max_uleb_value() {
        return mv_fail(st, 17);
    }
    if b < 128 {
        if idx > 0 {
            if b == 0 {
                return mv_fail(st, 13);
            }
        }
        __mind_store_i64(st + 0, pos + 1);
        __mind_store_i64(st + 8, acc2);
        __mind_store_i64(st + 16, 0);
        return 0;
    }
    mv_uleb(buf, len, pos + 1, idx + 1, acc2, mul * 128, st)
}

// Canonical minimal ULEB128 encoder. Writes at `pos`, returns the next offset.
pub fn mv_put_uleb(buf: i64, pos: i64, v: i64) -> i64 {
    let rest: i64 = v >> 7;
    if rest == 0 {
        __mind_store_i8(buf + pos, v & 127);
        return pos + 1;
    }
    __mind_store_i8(buf + pos, (v & 127) + 128);
    mv_put_uleb(buf, pos + 1, rest)
}

// ---- UTF-8 ----------------------------------------------------------------

pub fn mv_cont(buf: i64, i: i64, lo: i64, hi: i64) -> i64 {
    let b: i64 = __mind_load_i8(buf + i);
    if b < lo {
        return 0;
    }
    if b > hi {
        return 0;
    }
    1
}

// Validate [pos, end) as UTF-8. Returns 1 when valid, 0 otherwise.
pub fn mv_utf8(buf: i64, pos: i64, end: i64) -> i64 {
    if pos >= end {
        return 1;
    }
    let b: i64 = __mind_load_i8(buf + pos);
    if b < 128 {
        return mv_utf8(buf, pos + 1, end);
    }
    if b < 194 {
        return 0;
    }
    if b < 224 {
        if pos + 2 > end {
            return 0;
        }
        if mv_cont(buf, pos + 1, 128, 191) == 0 {
            return 0;
        }
        return mv_utf8(buf, pos + 2, end);
    }
    if b < 240 {
        if pos + 3 > end {
            return 0;
        }
        if b == 224 {
            if mv_cont(buf, pos + 1, 160, 191) == 0 {
                return 0;
            }
        }
        if b == 237 {
            if mv_cont(buf, pos + 1, 128, 159) == 0 {
                return 0;
            }
        }
        if b != 224 {
            if b != 237 {
                if mv_cont(buf, pos + 1, 128, 191) == 0 {
                    return 0;
                }
            }
        }
        if mv_cont(buf, pos + 2, 128, 191) == 0 {
            return 0;
        }
        return mv_utf8(buf, pos + 3, end);
    }
    if b > 244 {
        return 0;
    }
    if pos + 4 > end {
        return 0;
    }
    if b == 240 {
        if mv_cont(buf, pos + 1, 144, 191) == 0 {
            return 0;
        }
    }
    if b == 244 {
        if mv_cont(buf, pos + 1, 128, 143) == 0 {
            return 0;
        }
    }
    if b != 240 {
        if b != 244 {
            if mv_cont(buf, pos + 1, 128, 191) == 0 {
                return 0;
            }
        }
    }
    if mv_cont(buf, pos + 2, 128, 191) == 0 {
        return 0;
    }
    if mv_cont(buf, pos + 3, 128, 191) == 0 {
        return 0;
    }
    mv_utf8(buf, pos + 4, end)
}

// ---- byte-lexicographic compare -------------------------------------------

// Compare buf[a, a+alen) with buf[b, b+blen): 0 when a < b strictly, else 1.
// Shorter-is-less on a shared prefix, matching a byte-slice ordering.
pub fn mv_strictly_less(buf: i64, a: i64, alen: i64, b: i64, blen: i64, i: i64) -> i64 {
    if i >= alen {
        if i >= blen {
            return 0;
        }
        return 1;
    }
    if i >= blen {
        return 0;
    }
    let x: i64 = __mind_load_i8(buf + a + i);
    let y: i64 = __mind_load_i8(buf + b + i);
    if x < y {
        return 1;
    }
    if x > y {
        return 0;
    }
    mv_strictly_less(buf, a, alen, b, blen, i + 1)
}

// ---- string table: validating walk ----------------------------------------

// Walk `n` remaining entries starting at `pos`. `prev` / `prevlen` describe the
// previous entry (prevlen < 0 means there is none). `budget` is the reference
// allocation budget's remaining charge. On success stores the end cursor at
// st+0 and returns 0; otherwise stores and returns the cause.
// `tab` receives one 16-byte row per admitted entry -- its offset in `buf` and
// its length -- so that later sections can resolve a string index without
// re-walking the table. `idx` is the row being written.
pub fn mv_walk_strings(buf: i64, len: i64, pos: i64, n: i64, prev: i64, prevlen: i64, budget: i64, tab: i64, idx: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, pos);
        __mind_store_i64(st + 16, 0);
        __mind_store_i64(st + 24, budget);
        return 0;
    }
    let rc: i64 = mv_uleb(buf, len, pos, 0, 0, 1, st);
    if rc != 0 {
        return rc;
    }
    let slen: i64 = mv_st_value(st);
    let body: i64 = mv_st_cursor(st);
    if slen > len - body {
        return mv_fail(st, 10);
    }
    let budget2: i64 = budget - slen;
    if budget2 < 0 {
        return mv_fail(st, 22);
    }
    if mv_utf8(buf, body, body + slen) == 0 {
        return mv_fail(st, 21);
    }
    if prevlen >= 0 {
        if mv_strictly_less(buf, prev, prevlen, body, slen, 0) == 0 {
            return mv_fail(st, 19);
        }
    }
    __mind_store_i64(tab + 16 * idx + 0, body);
    __mind_store_i64(tab + 16 * idx + 8, slen);
    mv_walk_strings(buf, len, body + slen, n - 1, body, slen, budget2, tab, idx + 1, st)
}

// ---- string table: index resolution ---------------------------------------

pub fn mv_str_off(tab: i64, i: i64) -> i64 {
    __mind_load_i64(tab + 16 * i + 0)
}

pub fn mv_str_len(tab: i64, i: i64) -> i64 {
    __mind_load_i64(tab + 16 * i + 8)
}

// Read a ULEB string index at `pos`, refuse one that names no entry, and charge
// the reference's owned-projection cost of eight bytes per referenced byte.
// Stores the end cursor at st+0 and the index at st+8.
pub fn mv_string_ref(buf: i64, len: i64, pos: i64, nstr: i64, tab: i64, st: i64) -> i64 {
    let rc: i64 = mv_uleb(buf, len, pos, 0, 0, 1, st);
    if rc != 0 {
        return rc;
    }
    let idx: i64 = mv_st_value(st);
    if idx >= nstr {
        return mv_fail(st, 23);
    }
    mv_charge(st, mv_str_len(tab, idx) * 8)
}

// 1 when the component is nonempty and contains no '/', '\\' or "..", which is
// the reference's wire-safe identity predicate. No normalization is applied:
// the bytes are judged exactly as supplied.
pub fn mv_ident_ok(buf: i64, off: i64, n: i64, i: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    if i >= n {
        return 1;
    }
    let c: i64 = __mind_load_i8(buf + off + i);
    if c == 47 {
        return 0;
    }
    if c == 92 {
        return 0;
    }
    if c == 46 {
        if i + 1 < n {
            if __mind_load_i8(buf + off + i + 1) == 46 {
                return 0;
            }
        }
    }
    mv_ident_ok(buf, off, n, i + 1)
}

// ---- string table: canonical re-emission ----------------------------------

pub fn mv_copy(src: i64, dst: i64, n: i64, i: i64) -> i64 {
    if i >= n {
        return n;
    }
    __mind_store_i8(dst + i, __mind_load_i8(src + i));
    mv_copy(src, dst, n, i + 1)
}

// Re-emit `n` entries read from `inbuf` at `ipos` into `outbuf` at `opos`.
// Returns the next output offset. Only called after mv_walk_strings admitted
// the same bytes, so every read here is in bounds.
pub fn mv_emit_strings(inbuf: i64, outbuf: i64, ipos: i64, opos: i64, n: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, ipos);
        return opos;
    }
    mv_uleb(inbuf, ipos + 12, ipos, 0, 0, 1, st);
    let slen: i64 = mv_st_value(st);
    let body: i64 = mv_st_cursor(st);
    let o1: i64 = mv_put_uleb(outbuf, opos, slen);
    mv_copy(inbuf + body, outbuf + o1, slen, 0);
    mv_emit_strings(inbuf, outbuf, body + slen, o1 + slen, n - 1, st)
}

// ---- type descriptors -----------------------------------------------------

// Validate one type descriptor at `pos`, mirroring the reference read_type_expr.
// `nschema` bounds record references and `sch` supplies their identity string
// indices so the projection charge matches. Stores the end cursor at st+0 and
// the reference semantic element cost at st+32.
//
// The scalar, record-reference, fixed-array and dynamic-array tags are the four
// the core codec defines; every other tag is refused rather than skipped.
pub fn mv_type_expr(buf: i64, len: i64, pos: i64, depth: i64, nschema: i64, sch: i64, tab: i64, st: i64) -> i64 {
    if depth > 64 {
        return mv_fail(st, 24);
    }
    let rc0: i64 = mv_charge(st, 160);
    if rc0 != 0 {
        return rc0;
    }
    if pos >= len {
        return mv_fail(st, 10);
    }
    let tag: i64 = __mind_load_i8(buf + pos);
    if tag == 0 {
        if pos + 1 >= len {
            return mv_fail(st, 10);
        }
        let scalar: i64 = __mind_load_i8(buf + pos + 1);
        if scalar < 0 {
            return mv_fail(st, 25);
        }
        if scalar > 8 {
            return mv_fail(st, 25);
        }
        __mind_store_i64(st + 0, pos + 2);
        __mind_store_i64(st + 32, 1);
        return 0;
    }
    if tag == 1 {
        let rc: i64 = mv_uleb(buf, len, pos + 1, 0, 0, 1, st);
        if rc != 0 {
            return rc;
        }
        let idx: i64 = mv_st_value(st);
        let end: i64 = mv_st_cursor(st);
        if idx >= nschema {
            return mv_fail(st, 23);
        }
        let owner: i64 = __mind_load_i64(sch + 16 * idx + 0);
        let name: i64 = __mind_load_i64(sch + 16 * idx + 8);
        let olen: i64 = mv_str_len(tab, owner);
        let nlen: i64 = mv_str_len(tab, name);
        let rcc: i64 = mv_charge(st, olen * 8 + nlen * 8);
        if rcc != 0 {
            return rcc;
        }
        __mind_store_i64(st + 0, end);
        __mind_store_i64(st + 32, 1);
        return 0;
    }
    if tag == 2 {
        let rc: i64 = mv_uleb(buf, len, pos + 1, 0, 0, 1, st);
        if rc != 0 {
            return rc;
        }
        let extent: i64 = mv_st_value(st);
        let end: i64 = mv_st_cursor(st);
        if extent > 4294967295 {
            return mv_fail(st, 17);
        }
        let rce: i64 = mv_type_expr(buf, len, end, depth + 1, nschema, sch, tab, st);
        if rce != 0 {
            return rce;
        }
        let child: i64 = mv_st_elements(st);
        if extent == 0 {
            __mind_store_i64(st + 32, 0);
            return 0;
        }
        if child > mv_max_descriptor_elements() / extent {
            return mv_fail(st, 33);
        }
        __mind_store_i64(st + 32, child * extent);
        return 0;
    }
    if tag == 3 {
        let rce: i64 = mv_type_expr(buf, len, pos + 1, depth + 1, nschema, sch, tab, st);
        if rce != 0 {
            return rce;
        }
        let child: i64 = mv_st_elements(st);
        if child >= mv_max_descriptor_elements() {
            return mv_fail(st, 33);
        }
        __mind_store_i64(st + 32, child + 1);
        return 0;
    }
    mv_fail(st, 25)
}

// ---- schema identity headers ----------------------------------------------

// Walk `n` remaining schema identity headers, each a pair of string indices.
//
// Strict order is checked on the INDICES. That is exactly the reference's byte
// comparison of the identities, and not an approximation of it: the string
// table has already been admitted as unique and sorted by UTF-8 bytes, so index
// order and byte order are the same relation. If that table property is ever
// weakened this comparison stops being equivalent, which is why the string walk
// refuses a non-sorted table before any of this runs.
pub fn mv_walk_schema_headers(buf: i64, len: i64, pos: i64, n: i64, prevo: i64, prevn: i64, nstr: i64, tab: i64, sch: i64, idx: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, pos);
        return 0;
    }
    let rc1: i64 = mv_string_ref(buf, len, pos, nstr, tab, st);
    if rc1 != 0 {
        return rc1;
    }
    let owner: i64 = mv_st_value(st);
    let p1: i64 = mv_st_cursor(st);
    let rc2: i64 = mv_string_ref(buf, len, p1, nstr, tab, st);
    if rc2 != 0 {
        return rc2;
    }
    let name: i64 = mv_st_value(st);
    let p2: i64 = mv_st_cursor(st);
    if mv_ident_ok(buf, mv_str_off(tab, owner), mv_str_len(tab, owner), 0) == 0 {
        return mv_fail(st, 27);
    }
    if mv_ident_ok(buf, mv_str_off(tab, name), mv_str_len(tab, name), 0) == 0 {
        return mv_fail(st, 27);
    }
    if prevo >= 0 {
        if owner < prevo {
            return mv_fail(st, 26);
        }
        if owner == prevo {
            if name <= prevn {
                return mv_fail(st, 26);
            }
        }
    }
    __mind_store_i64(sch + 16 * idx + 0, owner);
    __mind_store_i64(sch + 16 * idx + 8, name);
    mv_walk_schema_headers(buf, len, p2, n - 1, owner, name, nstr, tab, sch, idx + 1, st)
}

// ---- schema field lists ---------------------------------------------------

// 1 when `idx` already appears among the first `n` recorded field names. Field
// names are string indices and the table is unique, so a repeated index is
// exactly a repeated name.
pub fn mv_seen(fld: i64, n: i64, idx: i64, i: i64) -> i64 {
    if i >= n {
        return 0;
    }
    if __mind_load_i64(fld + 8 * i) == idx {
        return 1;
    }
    mv_seen(fld, n, idx, i + 1)
}

// Walk the field list of ONE schema. `seen` counts the names already recorded
// in `fld` for this schema, which is what makes the duplicate check per-schema
// rather than global -- two schemas may each declare a field of the same name.
pub fn mv_walk_fields(buf: i64, len: i64, pos: i64, n: i64, seen: i64, nstr: i64, nschema: i64, tab: i64, sch: i64, fld: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, pos);
        return 0;
    }
    let rc1: i64 = mv_string_ref(buf, len, pos, nstr, tab, st);
    if rc1 != 0 {
        return rc1;
    }
    let name: i64 = mv_st_value(st);
    let p1: i64 = mv_st_cursor(st);
    if mv_str_len(tab, name) <= 0 {
        return mv_fail(st, 27);
    }
    if mv_seen(fld, seen, name, 0) == 1 {
        return mv_fail(st, 28);
    }
    __mind_store_i64(fld + 8 * seen, name);
    let rc2: i64 = mv_type_expr(buf, len, p1, 0, nschema, sch, tab, st);
    if rc2 != 0 {
        return rc2;
    }
    let rce: i64 = mv_add_elements(st, 40);
    if rce != 0 {
        return rce;
    }
    let p2: i64 = mv_st_cursor(st);
    mv_walk_fields(buf, len, p2, n - 1, seen + 1, nstr, nschema, tab, sch, fld, st)
}

// Walk every schema's field list, in header order.
pub fn mv_walk_schemas(buf: i64, len: i64, pos: i64, n: i64, nstr: i64, nschema: i64, tab: i64, sch: i64, fld: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, pos);
        return 0;
    }
    let rc: i64 = mv_uleb(buf, len, pos, 0, 0, 1, st);
    if rc != 0 {
        return rc;
    }
    let k: i64 = mv_st_value(st);
    let p1: i64 = mv_st_cursor(st);
    if k > len - p1 {
        return mv_fail(st, 10);
    }
    if k > mv_max_prefix() {
        return mv_fail(st, 17);
    }
    let rcc: i64 = mv_charge(st, k * 192);
    if rcc != 0 {
        return rcc;
    }
    let rcf: i64 = mv_walk_fields(buf, len, p1, k, 0, nstr, nschema, tab, sch, fld, st);
    if rcf != 0 {
        return rcf;
    }
    let p2: i64 = mv_st_cursor(st);
    mv_walk_schemas(buf, len, p2, n - 1, nstr, nschema, tab, sch, fld, st)
}

// ---- function declarations ------------------------------------------------

// The i-th byte of the reserved intrinsic owner "__mind_intrinsic".
pub fn mv_reserved_byte(i: i64) -> i64 {
    if i == 0 {
        return 95;
    }
    if i == 1 {
        return 95;
    }
    if i == 2 {
        return 109;
    }
    if i == 3 {
        return 105;
    }
    if i == 4 {
        return 110;
    }
    if i == 5 {
        return 100;
    }
    if i == 6 {
        return 95;
    }
    if i == 7 {
        return 105;
    }
    if i == 8 {
        return 110;
    }
    if i == 9 {
        return 116;
    }
    if i == 10 {
        return 114;
    }
    if i == 11 {
        return 105;
    }
    if i == 12 {
        return 110;
    }
    if i == 13 {
        return 115;
    }
    if i == 14 {
        return 105;
    }
    if i == 15 {
        return 99;
    }
    0 - 1
}

// 1 when the bytes at (off, n) are exactly the reserved intrinsic owner.
pub fn mv_is_reserved_owner(buf: i64, off: i64, n: i64, i: i64) -> i64 {
    if n != 16 {
        return 0;
    }
    if i >= 16 {
        return 1;
    }
    if __mind_load_i8(buf + off + i) != mv_reserved_byte(i) {
        return 0;
    }
    mv_is_reserved_owner(buf, off, n, i + 1)
}

// Exact logical names and arities of the ten reference registry rows admitted
// by canonical v0x04 declarations. Effects and FrozenNative result-use policy
// are registry metadata, not fields in the v0x04 wire signature. In particular,
// store signatures remain `(i64, i64) -> i64` here; later native admission owns
// the DiscardOnly use rule.
pub fn mv_intrinsic_name_len(id: i64) -> i64 {
    if id == 0 {
        return 5;
    }
    // alloc
    if id == 1 {
        return 4;
    }
    // argc
    if id == 2 {
        return 4;
    }
    // argv
    if id == 3 {
        return 5;
    }
    // load8
    if id == 4 {
        return 8;
    }
    // load_i64
    if id == 5 {
        return 4;
    }
    // open
    if id == 6 {
        return 4;
    }
    // read
    if id == 7 {
        return 6;
    }
    // store8
    if id == 8 {
        return 9;
    }
    // store_i64
    if id == 9 {
        return 5;
    }
    // write
    0
}

pub fn mv_intrinsic_arity(id: i64) -> i64 {
    if id == 1 {
        return 0;
    }
    if id == 0 {
        return 1;
    }
    if id == 2 {
        return 1;
    }
    if id == 3 {
        return 1;
    }
    if id == 4 {
        return 1;
    }
    if id == 5 {
        return 1;
    }
    if id == 7 {
        return 2;
    }
    if id == 8 {
        return 2;
    }
    if id == 6 {
        return 4;
    }
    if id == 9 {
        return 4;
    }
    0 - 1
}

pub fn mv_intrinsic_name_byte(id: i64, i: i64) -> i64 {
    if id == 0 {
        // alloc
        if i == 0 {
            return 97;
        }
        if i == 1 {
            return 108;
        }
        if i == 2 {
            return 108;
        }
        if i == 3 {
            return 111;
        }
        return 99;
    }
    if id == 1 {
        // argc
        if i == 0 {
            return 97;
        }
        if i == 1 {
            return 114;
        }
        if i == 2 {
            return 103;
        }
        return 99;
    }
    if id == 2 {
        // argv
        if i == 0 {
            return 97;
        }
        if i == 1 {
            return 114;
        }
        if i == 2 {
            return 103;
        }
        return 118;
    }
    if id == 3 {
        // load8
        if i == 0 {
            return 108;
        }
        if i == 1 {
            return 111;
        }
        if i == 2 {
            return 97;
        }
        if i == 3 {
            return 100;
        }
        return 56;
    }
    if id == 4 {
        // load_i64
        if i == 0 {
            return 108;
        }
        if i == 1 {
            return 111;
        }
        if i == 2 {
            return 97;
        }
        if i == 3 {
            return 100;
        }
        if i == 4 {
            return 95;
        }
        if i == 5 {
            return 105;
        }
        if i == 6 {
            return 54;
        }
        return 52;
    }
    if id == 5 {
        // open
        if i == 0 {
            return 111;
        }
        if i == 1 {
            return 112;
        }
        if i == 2 {
            return 101;
        }
        return 110;
    }
    if id == 6 {
        // read
        if i == 0 {
            return 114;
        }
        if i == 1 {
            return 101;
        }
        if i == 2 {
            return 97;
        }
        return 100;
    }
    if id == 7 {
        // store8
        if i == 0 {
            return 115;
        }
        if i == 1 {
            return 116;
        }
        if i == 2 {
            return 111;
        }
        if i == 3 {
            return 114;
        }
        if i == 4 {
            return 101;
        }
        return 56;
    }
    if id == 8 {
        // store_i64
        if i == 0 {
            return 115;
        }
        if i == 1 {
            return 116;
        }
        if i == 2 {
            return 111;
        }
        if i == 3 {
            return 114;
        }
        if i == 4 {
            return 101;
        }
        if i == 5 {
            return 95;
        }
        if i == 6 {
            return 105;
        }
        if i == 7 {
            return 54;
        }
        return 52;
    }
    if id == 9 {
        // write
        if i == 0 {
            return 119;
        }
        if i == 1 {
            return 114;
        }
        if i == 2 {
            return 105;
        }
        if i == 3 {
            return 116;
        }
        return 101;
    }
    0 - 1
}

pub fn mv_intrinsic_name_eq(buf: i64, off: i64, id: i64, i: i64) -> i64 {
    if i >= mv_intrinsic_name_len(id) {
        return 1;
    }
    if __mind_load_i8(buf + off + i) != mv_intrinsic_name_byte(id, i) {
        return 0;
    }
    mv_intrinsic_name_eq(buf, off, id, i + 1)
}

pub fn mv_intrinsic_find(buf: i64, off: i64, n: i64, id: i64) -> i64 {
    if id >= 10 {
        return 0 - 1;
    }
    if n == mv_intrinsic_name_len(id) {
        if mv_intrinsic_name_eq(buf, off, id, 0) == 1 {
            return id;
        }
    }
    mv_intrinsic_find(buf, off, n, id + 1)
}

// Walk `n` signature parameters, each a semantic type descriptor. The wire
// grammar for a semantic type is the schema field grammar, so the same walker
// admits both; the reference keeps two functions over one encoding.
pub fn mv_walk_params(buf: i64, len: i64, pos: i64, n: i64, nschema: i64, sch: i64, tab: i64, declaration_kind: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, pos);
        return 0;
    }
    let rc: i64 = mv_type_expr(buf, len, pos, 0, nschema, sch, tab, st);
    if rc != 0 {
        return rc;
    }
    let rce: i64 = mv_add_elements(st, 48);
    if rce != 0 {
        return rce;
    }
    if declaration_kind == 2 {
        if __mind_load_i8(buf + pos) != 0 {
            __mind_store_i64(st + 56, 1)
        }
        if __mind_load_i8(buf + pos + 1) != 1 {
            __mind_store_i64(st + 56, 1)
        }
    }
    let p1: i64 = mv_st_cursor(st);
    mv_walk_params(buf, len, p1, n - 1, nschema, sch, tab, declaration_kind, st)
}

// Walk `n` remaining function declarations. Order is checked on the identity
// string indices for the same reason it is for schemas.
pub fn mv_walk_functions(buf: i64, len: i64, pos: i64, n: i64, prevo: i64, prevn: i64, nstr: i64, nschema: i64, tab: i64, sch: i64, fnt: i64, idx: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, pos);
        return 0;
    }
    let rc1: i64 = mv_string_ref(buf, len, pos, nstr, tab, st);
    if rc1 != 0 {
        return rc1;
    }
    let owner: i64 = mv_st_value(st);
    let p1: i64 = mv_st_cursor(st);
    let rc2: i64 = mv_string_ref(buf, len, p1, nstr, tab, st);
    if rc2 != 0 {
        return rc2;
    }
    let name: i64 = mv_st_value(st);
    let p2: i64 = mv_st_cursor(st);
    let ooff: i64 = mv_str_off(tab, owner);
    let olen: i64 = mv_str_len(tab, owner);
    if mv_ident_ok(buf, ooff, olen, 0) == 0 {
        return mv_fail(st, 27);
    }
    if mv_ident_ok(buf, mv_str_off(tab, name), mv_str_len(tab, name), 0) == 0 {
        return mv_fail(st, 27);
    }
    if prevo >= 0 {
        if owner < prevo {
            return mv_fail(st, 30);
        }
        if owner == prevo {
            if name <= prevn {
                return mv_fail(st, 30);
            }
        }
    }
    if p2 >= len {
        return mv_fail(st, 10);
    }
    let kind: i64 = __mind_load_i8(buf + p2);
    if kind < 0 {
        return mv_fail(st, 29);
    }
    if kind > 2 {
        return mv_fail(st, 29);
    }
    // The reserved owner and the intrinsic kind imply each other. Both
    // directions are refused, so neither a disguised intrinsic nor an ordinary
    // function wearing the reserved owner is admitted.
    let reserved: i64 = mv_is_reserved_owner(buf, ooff, olen, 0);
    if kind == 2 {
        if reserved == 0 {
            return mv_fail(st, 31);
        }
    }
    if kind != 2 {
        if reserved == 1 {
            return mv_fail(st, 31);
        }
    }
    __mind_store_i64(st + 56, 0);
    let intrinsic_id: i64 = if kind == 2 {
        mv_intrinsic_find(buf, mv_str_off(tab, name), mv_str_len(tab, name), 0)
    } else {
        0 - 1
    };
    if kind == 2 {
        if intrinsic_id < 0 {
            __mind_store_i64(st + 56, 1)
        }
    }
    let rc3: i64 = mv_uleb(buf, len, p2 + 1, 0, 0, 1, st);
    if rc3 != 0 {
        return rc3;
    }
    let nparam: i64 = mv_st_value(st);
    let p3: i64 = mv_st_cursor(st);
    if nparam > len - p3 {
        return mv_fail(st, 10);
    }
    if kind == 2 {
        if intrinsic_id >= 0 {
            if nparam != mv_intrinsic_arity(intrinsic_id) {
                __mind_store_i64(st + 56, 1)
            }
        }
    }
    let rcc: i64 = mv_charge(st, nparam * 128);
    if rcc != 0 {
        return rcc;
    }
    let rc4: i64 = mv_walk_params(buf, len, p3, nparam, nschema, sch, tab, kind, st);
    if rc4 != 0 {
        return rc4;
    }
    let p4: i64 = mv_st_cursor(st);
    if p4 >= len {
        return mv_fail(st, 10);
    }
    let present: i64 = __mind_load_i8(buf + p4);
    if present == 0 {
        if kind == 2 {
            return mv_fail(st, 34);
        }
        __mind_store_i64(fnt + 56 * idx + 0, owner);
        __mind_store_i64(fnt + 56 * idx + 8, name);
        __mind_store_i64(fnt + 56 * idx + 16, 0);
        __mind_store_i64(fnt + 56 * idx + 24, 0);
        __mind_store_i64(fnt + 56 * idx + 32, 0);
        __mind_store_i64(fnt + 56 * idx + 40, nparam);
        __mind_store_i64(fnt + 56 * idx + 48, kind);
        return mv_walk_functions(buf, len, p4 + 1, n - 1, owner, name, nstr, nschema, tab, sch, fnt, idx + 1, st);
    }
    if present != 1 {
        return mv_fail(st, 32);
    }
    let rc5: i64 = mv_type_expr(buf, len, p4 + 1, 0, nschema, sch, tab, st);
    if rc5 != 0 {
        return rc5;
    }
    let rce: i64 = mv_add_elements(st, 48);
    if rce != 0 {
        return rce;
    }
    let p5: i64 = mv_st_cursor(st);
    if kind == 2 {
        if __mind_load_i8(buf + p4 + 1) != 0 {
            __mind_store_i64(st + 56, 1)
        }
        if __mind_load_i8(buf + p4 + 2) != 1 {
            __mind_store_i64(st + 56, 1)
        }
        if __mind_load_i64(st + 56) != 0 {
            return mv_fail(st, 34);
        }
    }
    __mind_store_i64(fnt + 56 * idx + 0, owner);
    __mind_store_i64(fnt + 56 * idx + 8, name);
    __mind_store_i64(fnt + 56 * idx + 16, p4 + 1);
    __mind_store_i64(fnt + 56 * idx + 24, p5);
    __mind_store_i64(fnt + 56 * idx + 32, 1);
    __mind_store_i64(fnt + 56 * idx + 40, nparam);
    __mind_store_i64(fnt + 56 * idx + 48, kind);
    mv_walk_functions(buf, len, p5, n - 1, owner, name, nstr, nschema, tab, sch, fnt, idx + 1, st)
}

// ---- schema section: canonical re-emission --------------------------------

// Re-emit one type descriptor, regenerating every ULEB rather than copying it,
// so a non-minimal encoding in the input cannot survive into the output and
// still compare equal. Stores the next input offset at st+0, returns the next
// output offset. Only called after mv_type_expr admitted the same bytes.
pub fn mv_emit_type(inbuf: i64, outbuf: i64, ipos: i64, opos: i64, st: i64) -> i64 {
    let tag: i64 = __mind_load_i8(inbuf + ipos);
    __mind_store_i8(outbuf + opos, tag);
    if tag == 0 {
        __mind_store_i8(outbuf + opos + 1, __mind_load_i8(inbuf + ipos + 1));
        __mind_store_i64(st + 0, ipos + 2);
        return opos + 2;
    }
    if tag == 1 {
        mv_uleb(inbuf, ipos + 12, ipos + 1, 0, 0, 1, st);
        let v: i64 = mv_st_value(st);
        return mv_put_uleb(outbuf, opos + 1, v);
    }
    if tag == 2 {
        mv_uleb(inbuf, ipos + 12, ipos + 1, 0, 0, 1, st);
        let v: i64 = mv_st_value(st);
        let e: i64 = mv_st_cursor(st);
        let o1: i64 = mv_put_uleb(outbuf, opos + 1, v);
        return mv_emit_type(inbuf, outbuf, e, o1, st);
    }
    mv_emit_type(inbuf, outbuf, ipos + 1, opos + 1, st)
}

pub fn mv_emit_schema_headers(inbuf: i64, outbuf: i64, ipos: i64, opos: i64, n: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, ipos);
        return opos;
    }
    mv_uleb(inbuf, ipos + 12, ipos, 0, 0, 1, st);
    let owner: i64 = mv_st_value(st);
    let p1: i64 = mv_st_cursor(st);
    mv_uleb(inbuf, p1 + 12, p1, 0, 0, 1, st);
    let name: i64 = mv_st_value(st);
    let p2: i64 = mv_st_cursor(st);
    let o1: i64 = mv_put_uleb(outbuf, opos, owner);
    let o2: i64 = mv_put_uleb(outbuf, o1, name);
    mv_emit_schema_headers(inbuf, outbuf, p2, o2, n - 1, st)
}

pub fn mv_emit_fields(inbuf: i64, outbuf: i64, ipos: i64, opos: i64, n: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, ipos);
        return opos;
    }
    mv_uleb(inbuf, ipos + 12, ipos, 0, 0, 1, st);
    let name: i64 = mv_st_value(st);
    let p1: i64 = mv_st_cursor(st);
    let o1: i64 = mv_put_uleb(outbuf, opos, name);
    let o2: i64 = mv_emit_type(inbuf, outbuf, p1, o1, st);
    let p2: i64 = mv_st_cursor(st);
    mv_emit_fields(inbuf, outbuf, p2, o2, n - 1, st)
}

pub fn mv_emit_schema_bodies(inbuf: i64, outbuf: i64, ipos: i64, opos: i64, n: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, ipos);
        return opos;
    }
    mv_uleb(inbuf, ipos + 12, ipos, 0, 0, 1, st);
    let k: i64 = mv_st_value(st);
    let p1: i64 = mv_st_cursor(st);
    let o1: i64 = mv_put_uleb(outbuf, opos, k);
    let o2: i64 = mv_emit_fields(inbuf, outbuf, p1, o1, k, st);
    let p2: i64 = mv_st_cursor(st);
    mv_emit_schema_bodies(inbuf, outbuf, p2, o2, n - 1, st)
}

pub fn mv_emit_params(inbuf: i64, outbuf: i64, ipos: i64, opos: i64, n: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, ipos);
        return opos;
    }
    let o1: i64 = mv_emit_type(inbuf, outbuf, ipos, opos, st);
    let p1: i64 = mv_st_cursor(st);
    mv_emit_params(inbuf, outbuf, p1, o1, n - 1, st)
}

pub fn mv_emit_functions(inbuf: i64, outbuf: i64, ipos: i64, opos: i64, n: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, ipos);
        return opos;
    }
    mv_uleb(inbuf, ipos + 12, ipos, 0, 0, 1, st);
    let owner: i64 = mv_st_value(st);
    let p1: i64 = mv_st_cursor(st);
    mv_uleb(inbuf, p1 + 12, p1, 0, 0, 1, st);
    let name: i64 = mv_st_value(st);
    let p2: i64 = mv_st_cursor(st);
    let o1: i64 = mv_put_uleb(outbuf, opos, owner);
    let o2: i64 = mv_put_uleb(outbuf, o1, name);
    __mind_store_i8(outbuf + o2, __mind_load_i8(inbuf + p2));
    mv_uleb(inbuf, p2 + 13, p2 + 1, 0, 0, 1, st);
    let nparam: i64 = mv_st_value(st);
    let p3: i64 = mv_st_cursor(st);
    let o3: i64 = mv_put_uleb(outbuf, o2 + 1, nparam);
    let o4: i64 = mv_emit_params(inbuf, outbuf, p3, o3, nparam, st);
    let p4: i64 = mv_st_cursor(st);
    let present: i64 = __mind_load_i8(inbuf + p4);
    __mind_store_i8(outbuf + o4, present);
    if present == 0 {
        return mv_emit_functions(inbuf, outbuf, p4 + 1, o4 + 1, n - 1, st);
    }
    let o5: i64 = mv_emit_type(inbuf, outbuf, p4 + 1, o4 + 1, st);
    let p5: i64 = mv_st_cursor(st);
    mv_emit_functions(inbuf, outbuf, p5, o5, n - 1, st)
}

// ---- function identity table ----------------------------------------------

// Total identity bytes of function `i`, for the reference's identity-projection
// charge. `fnt` holds one 56-byte row per admitted declaration: the owner and
// name string indices, declared return descriptor range, parameter count, and
// declaration kind (Local, External, or Intrinsic).
pub fn mv_fn_ident_bytes(fnt: i64, tab: i64, i: i64) -> i64 {
    let owner: i64 = __mind_load_i64(fnt + 56 * i + 0);
    let name: i64 = __mind_load_i64(fnt + 56 * i + 8);
    mv_str_len(tab, owner) + mv_str_len(tab, name)
}

pub fn mv_fn_return_present(fnt: i64, i: i64) -> i64 {
    __mind_load_i64(fnt + 56 * i + 32)
}

pub fn mv_fn_return_start(fnt: i64, i: i64) -> i64 {
    __mind_load_i64(fnt + 56 * i + 16)
}

pub fn mv_fn_return_end(fnt: i64, i: i64) -> i64 {
    __mind_load_i64(fnt + 56 * i + 24)
}

pub fn mv_fn_param_count(fnt: i64, i: i64) -> i64 {
    __mind_load_i64(fnt + 56 * i + 40)
}

pub fn mv_fn_kind(fnt: i64, i: i64) -> i64 {
    __mind_load_i64(fnt + 56 * i + 48)
}

// Keep the optional return-ID branch in the parser helper, where the frozen
// native backend already accepts the wire tag tests. The declaration table is
// only available after the body, so this helper compares the captured
// presence and then arms exact descriptor-row validation.
pub fn mv_prepare_return(st: i64, fnt: i64, fidx: i64, depth: i64) -> i64 {
    let got: i64 = __mind_load_i64(st + 128 + depth * 8);
    let expected: i64 = mv_fn_return_present(fnt, fidx);
    if got != expected {
        return mv_fail(st, 42);
    }
    if got == 1 {
        __mind_store_i64(st + 80, __mind_load_i64(st + 6400 + depth * 8));
        __mind_store_i64(st + 88, mv_fn_return_start(fnt, fidx));
        __mind_store_i64(st + 96, mv_fn_return_end(fnt, fidx));
        __mind_store_i64(st + 104, 0);
        __mind_store_i64(st + 112, 1)
    } else {
        __mind_store_i64(st + 112, 0)
    }
    0
}

pub fn mv_fn_name_matches(buf: i64, tab: i64, fnt: i64, i: i64, name: i64) -> i64 {
    let declared: i64 = __mind_load_i64(fnt + 56 * i + 8);
    let left: i64 = mv_str_off(tab, declared);
    let right: i64 = mv_str_off(tab, name);
    let left_len: i64 = mv_str_len(tab, declared);
    let right_len: i64 = mv_str_len(tab, name);
    if left_len != right_len {
        return 0;
    }
    mv_bytes_equal(buf, left, right, left_len)
}

pub fn mv_prepare_params(st: i64, fnt: i64, fidx: i64, depth: i64) -> i64 {
    let got: i64 = __mind_load_i64(st + 4256 + depth * 8);
    let expected: i64 = mv_fn_param_count(fnt, fidx);
    if got != expected {
        return mv_fail(st, 44);
    }
    0
}

// ---- module-wide function definition set ----------------------------------

// Zero `n` slots. __mind_alloc is malloc, NOT zeroed: runtime-support's
// allocator hands back whatever the heap held. Every table this program indexes
// by a decoded value must therefore be cleared before its first read, or the
// verdict depends on heap residue.
pub fn mv_zero(ptr: i64, n: i64, i: i64) -> i64 {
    if i >= n {
        return 0;
    }
    __mind_store_i64(ptr + 8 * i, 0);
    mv_zero(ptr, n, i + 1)
}

// Record that declaration `fidx` has been DEFINED by a local FnDef body, and
// report whether it already was.
//
// This is the one piece of per-module state the FnDef walk carries. Everything
// else in a FnDef frame is depth-indexed because it belongs to that frame; this
// deliberately is NOT, because the reference's rule is module-wide: its
// `identities` set spans siblings AND nested bodies for the whole stream
// (canonical_verify.rs:326-330), and it is checked before the name, kind and
// arity rules. A depth-indexed version of this would accept exactly the bodies
// it exists to refuse.
pub fn mv_define_function(fdef: i64, fidx: i64) -> i64 {
    if __mind_load_i64(fdef + 8 * fidx) != 0 {
        return 1;
    }
    __mind_store_i64(fdef + 8 * fidx, 1);
    0
}

// ---- instructions ---------------------------------------------------------

// Read a ULEB at `pos` into st+8 and the end cursor into st+0, or return the
// cause. Every instruction operand that is a bare value id uses this.
pub fn mv_vid(buf: i64, len: i64, pos: i64, st: i64) -> i64 {
    let rc: i64 = mv_uleb(buf, len, pos, 0, 0, 1, st);
    if rc != 0 {
        return rc;
    }
    if __mind_load_i64(st + 72) == 1 {
        let value: i64 = mv_st_value(st);
        let exclusive: i64 = value + 1;
        if exclusive > __mind_load_i64(st + 64) {
            __mind_store_i64(st + 64, exclusive)
        }
    }
    0
}

// An explicit 0/1 presence tag followed, when 1, by a value id.
pub fn mv_opt_vid(buf: i64, len: i64, pos: i64, st: i64) -> i64 {
    if pos >= len {
        return mv_fail(st, 10);
    }
    let tag: i64 = __mind_load_i8(buf + pos);
    if tag == 0 {
        __mind_store_i64(st + 120, 0);
        __mind_store_i64(st + 0, pos + 1);
        return 0;
    }
    if tag != 1 {
        return mv_fail(st, 32);
    }
    __mind_store_i64(st + 120, 1);
    mv_vid(buf, len, pos + 1, st)
}

// An explicit 0/1 presence tag followed, when 1, by eight little-endian bytes.
// The bytes are not interpreted: the mirror re-emits them verbatim and never
// performs floating-point arithmetic, so no rounding behaviour is introduced.
pub fn mv_opt_f64(buf: i64, len: i64, pos: i64, st: i64) -> i64 {
    if pos >= len {
        return mv_fail(st, 10);
    }
    let tag: i64 = __mind_load_i8(buf + pos);
    if tag == 0 {
        __mind_store_i64(st + 0, pos + 1);
        return 0;
    }
    if tag != 1 {
        return mv_fail(st, 32);
    }
    if pos + 9 > len {
        return mv_fail(st, 10);
    }
    __mind_store_i64(st + 0, pos + 9);
    0
}

// A reserved compatibility count. The reference checks the remaining-bytes
// bound BEFORE the zero test, and that order is observable: a huge nonzero
// count is refused as a bound breach, a small one as a populated table. Both
// are reproduced, and neither charges the budget.
pub fn mv_reserved_zero(buf: i64, len: i64, pos: i64, st: i64) -> i64 {
    let rc: i64 = mv_uleb(buf, len, pos, 0, 0, 1, st);
    if rc != 0 {
        return rc;
    }
    let n: i64 = mv_st_value(st);
    let p1: i64 = mv_st_cursor(st);
    if n > len - p1 {
        return mv_fail(st, 10);
    }
    if n != 0 {
        return mv_fail(st, 38);
    }
    0
}

// `n` semantic value rows, each a value id and a descriptor, strictly sorted by
// value id. Used for a function's own scoped table. When return validation is
// active, the row carrying the declared ret_id must reproduce the declaration's
// exact descriptor bytes.
pub fn mv_walk_value_rows(buf: i64, len: i64, pos: i64, n: i64, prev: i64, nschema: i64, sch: i64, tab: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, pos);
        return 0;
    }
    let rc: i64 = mv_vid(buf, len, pos, st);
    if rc != 0 {
        return rc;
    }
    let vid: i64 = mv_st_value(st);
    let p1: i64 = mv_st_cursor(st);
    if prev >= 0 {
        if vid <= prev {
            return mv_fail(st, 39);
        }
    }
    let rct: i64 = mv_type_expr(buf, len, p1, 0, nschema, sch, tab, st);
    if rct != 0 {
        return rct;
    }
    let p2: i64 = mv_st_cursor(st);
    if __mind_load_i64(st + 112) == 1 {
        if vid == __mind_load_i64(st + 80) {
            let expected_start: i64 = __mind_load_i64(st + 88);
            let expected_end: i64 = __mind_load_i64(st + 96);
            if p2 - p1 != expected_end - expected_start {
                return mv_fail(st, 42);
            }
            if mv_bytes_equal(buf, p1, expected_start, p2 - p1) == 0 {
                return mv_fail(st, 42);
            }
            __mind_store_i64(st + 104, 1)
        }
    }
    mv_walk_value_rows(buf, len, p2, n - 1, vid, nschema, sch, tab, st)
}

// `n` FnDef parameters, each a string reference and a value id.
pub fn mv_walk_named_values(buf: i64, len: i64, pos: i64, n: i64, nstr: i64, tab: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, pos);
        return 0;
    }
    let rc: i64 = mv_string_ref(buf, len, pos, nstr, tab, st);
    if rc != 0 {
        return rc;
    }
    let p1: i64 = mv_st_cursor(st);
    let rcv: i64 = mv_vid(buf, len, p1, st);
    if rcv != 0 {
        return rcv;
    }
    let p2: i64 = mv_st_cursor(st);
    mv_walk_named_values(buf, len, p2, n - 1, nstr, tab, st)
}

// `n` call arguments, each a bare value id.
pub fn mv_walk_args(buf: i64, len: i64, pos: i64, n: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, pos);
        return 0;
    }
    let rc: i64 = mv_vid(buf, len, pos, st);
    if rc != 0 {
        return rc;
    }
    let p1: i64 = mv_st_cursor(st);
    mv_walk_args(buf, len, p1, n - 1, st)
}

// Decode one instruction at `pos`. Stores the end cursor at st+0.
//
// The depth limit and the per-instruction charge are applied BEFORE the opcode
// byte is read, exactly as the reference does, so a stream that reaches the
// nesting limit is refused without consuming an opcode.
//
// Opcodes outside the core scalar subset are refused by name (37). They are not
// skipped and their operands are never guessed at: an unknown opcode makes the
// remaining byte stream unparseable, so continuing would be invention.
pub fn mv_instr(buf: i64, len: i64, pos: i64, depth: i64, nstr: i64, nschema: i64, nfunc: i64, tab: i64, sch: i64, fnt: i64, fdef: i64, st: i64) -> i64 {
    if depth >= 256 {
        return mv_fail(st, 36);
    }
    let rc0: i64 = mv_charge(st, 320);
    if rc0 != 0 {
        return rc0;
    }
    if pos >= len {
        return mv_fail(st, 10);
    }
    let op: i64 = __mind_load_i8(buf + pos);

    // ConstI64: dst, then a zigzag ULEB payload the mirror re-emits verbatim.
    if op == 1 {
        let rc1: i64 = mv_vid(buf, len, pos + 1, st);
        if rc1 != 0 {
            return rc1;
        }
        let p1: i64 = mv_st_cursor(st);
        return mv_uleb(buf, len, p1, 0, 0, 1, st);
    }

    // ConstF64: dst, then eight little-endian bytes.
    if op == 2 {
        let rc1: i64 = mv_vid(buf, len, pos + 1, st);
        if rc1 != 0 {
            return rc1;
        }
        let p1: i64 = mv_st_cursor(st);
        if p1 + 8 > len {
            return mv_fail(st, 10);
        }
        __mind_store_i64(st + 0, p1 + 8);
        return 0;
    }

    // BinOp: dst, operator tag, lhs, rhs. Tags 0..10 are the core operators;
    // 11 and above are std-surface operators, and a body carrying one declares
    // the std-surface bit, which this mirror already refused at the header.
    if op == 4 {
        let rc1: i64 = mv_vid(buf, len, pos + 1, st);
        if rc1 != 0 {
            return rc1;
        }
        let p1: i64 = mv_st_cursor(st);
        if p1 >= len {
            return mv_fail(st, 10);
        }
        let tag: i64 = __mind_load_i8(buf + p1);
        if tag < 0 {
            return mv_fail(st, 40);
        }
        if tag > 10 {
            return mv_fail(st, 40);
        }
        let rc2: i64 = mv_vid(buf, len, p1 + 1, st);
        if rc2 != 0 {
            return rc2;
        }
        let p2: i64 = mv_st_cursor(st);
        return mv_vid(buf, len, p2, st);
    }

    // Output: one value id.
    if op == 19 {
        return mv_vid(buf, len, pos + 1, st);
    }

    // Return: an optional value id.
    if op == 23 {
        return mv_opt_vid(buf, len, pos + 1, st);
    }

    // Param: dst, name, index.
    if op == 24 {
        let rc1: i64 = mv_vid(buf, len, pos + 1, st);
        if rc1 != 0 {
            return rc1;
        }
        let p1: i64 = mv_st_cursor(st);
        let rc2: i64 = mv_string_ref(buf, len, p1, nstr, tab, st);
        if rc2 != 0 {
            return rc2;
        }
        let p2: i64 = mv_st_cursor(st);
        return mv_uleb(buf, len, p2, 0, 0, 1, st);
    }

    // Call: dst, name, argument count, arguments, resolved callee.
    if op == 22 {
        let rc1: i64 = mv_vid(buf, len, pos + 1, st);
        if rc1 != 0 {
            return rc1;
        }
        let p1: i64 = mv_st_cursor(st);
        let rc2: i64 = mv_string_ref(buf, len, p1, nstr, tab, st);
        if rc2 != 0 {
            return rc2;
        }
        let p2: i64 = mv_st_cursor(st);
        let rc3: i64 = mv_uleb(buf, len, p2, 0, 0, 1, st);
        if rc3 != 0 {
            return rc3;
        }
        let nargs: i64 = mv_st_value(st);
        let p3: i64 = mv_st_cursor(st);
        if nargs > len - p3 {
            return mv_fail(st, 10);
        }
        let rcc: i64 = mv_charge(st, nargs * 32);
        if rcc != 0 {
            return rcc;
        }
        let rc4: i64 = mv_walk_args(buf, len, p3, nargs, st);
        if rc4 != 0 {
            return rc4;
        }
        let p4: i64 = mv_st_cursor(st);
        let rc5: i64 = mv_uleb(buf, len, p4, 0, 0, 1, st);
        if rc5 != 0 {
            return rc5;
        }
        let fidx: i64 = mv_st_value(st);
        let p5: i64 = mv_st_cursor(st);
        if fidx >= nfunc {
            return mv_fail(st, 23);
        }
        let rcf: i64 = mv_charge(st, mv_fn_ident_bytes(fnt, tab, fidx) * 8);
        if rcf != 0 {
            return rcf;
        }
        __mind_store_i64(st + 0, p5);
        return 0;
    }

    // FnDef: name, parameters, optional return id, optional reap threshold,
    // a NESTED body, the reserved legacy table, the resolved identity, and the
    // function's own scoped semantic value rows.
    if op == 21 {
        // The reference's module next_id check excludes every function's
        // declaration/body namespace. Disable module tracking for this whole
        // instruction, restoring it before the caller advances its stream.
        let prior_track: i64 = __mind_load_i64(st + 72);
        __mind_store_i64(st + 72, 0);
        let rc1: i64 = mv_string_ref(buf, len, pos + 1, nstr, tab, st);
        if rc1 != 0 {
            return rc1;
        }
        __mind_store_i64(st + 2176 + depth * 8, mv_st_value(st));
        let p1: i64 = mv_st_cursor(st);
        let rc2: i64 = mv_uleb(buf, len, p1, 0, 0, 1, st);
        if rc2 != 0 {
            return rc2;
        }
        let nparam: i64 = mv_st_value(st);
        __mind_store_i64(st + 4256 + depth * 8, nparam);
        let p2: i64 = mv_st_cursor(st);
        if nparam > len - p2 {
            return mv_fail(st, 10);
        }
        let rcp: i64 = mv_charge(st, nparam * 96);
        if rcp != 0 {
            return rcp;
        }
        let rc3: i64 = mv_walk_named_values(buf, len, p2, nparam, nstr, tab, st);
        if rc3 != 0 {
            return rc3;
        }
        let p3: i64 = mv_st_cursor(st);
        let rc4: i64 = mv_opt_vid(buf, len, p3, st);
        if rc4 != 0 {
            return rc4;
        }
        __mind_store_i64(st + 6400 + depth * 8, mv_st_value(st));
        __mind_store_i64(st + 128 + depth * 8, __mind_load_i64(st + 120));
        let p4: i64 = mv_st_cursor(st);
        let rc5: i64 = mv_opt_f64(buf, len, p4, st);
        if rc5 != 0 {
            return rc5;
        }
        let p5: i64 = mv_st_cursor(st);
        let rc6: i64 = mv_uleb(buf, len, p5, 0, 0, 1, st);
        if rc6 != 0 {
            return rc6;
        }
        let nbody: i64 = mv_st_value(st);
        let p6: i64 = mv_st_cursor(st);
        if nbody > len - p6 {
            return mv_fail(st, 10);
        }
        let rcb: i64 = mv_charge(st, nbody * 320);
        if rcb != 0 {
            return rcb;
        }
        let rc7: i64 = mv_walk_instrs(buf, len, p6, nbody, depth + 1, nstr, nschema, nfunc, tab, sch, fnt, fdef, st);
        if rc7 != 0 {
            return rc7;
        }
        let p7: i64 = mv_st_cursor(st);
        let rc8: i64 = mv_reserved_zero(buf, len, p7, st);
        if rc8 != 0 {
            return rc8;
        }
        let p8: i64 = mv_st_cursor(st);
        let rc9: i64 = mv_uleb(buf, len, p8, 0, 0, 1, st);
        if rc9 != 0 {
            return rc9;
        }
        let fidx: i64 = mv_st_value(st);
        let p9: i64 = mv_st_cursor(st);
        if fidx >= nfunc {
            return mv_fail(st, 23);
        }
        if mv_define_function(fdef, fidx) == 1 {
            return mv_fail(st, 46);
        }
        if mv_fn_name_matches(buf, tab, fnt, fidx, __mind_load_i64(st + 2176 + depth * 8)) == 0 {
            return mv_fail(st, 43);
        }
        if mv_fn_kind(fnt, fidx) != 0 {
            return mv_fail(st, 45);
        }
        let rcpp: i64 = mv_prepare_params(st, fnt, fidx, depth);
        if rcpp != 0 {
            return rcpp;
        }
        let rcpres: i64 = mv_prepare_return(st, fnt, fidx, depth);
        if rcpres != 0 {
            return rcpres;
        }
        let rcf: i64 = mv_charge(st, mv_fn_ident_bytes(fnt, tab, fidx) * 8);
        if rcf != 0 {
            return rcf;
        }
        let rc10: i64 = mv_uleb(buf, len, p9, 0, 0, 1, st);
        if rc10 != 0 {
            return rc10;
        }
        let nrow: i64 = mv_st_value(st);
        let p10: i64 = mv_st_cursor(st);
        if nrow > len - p10 {
            return mv_fail(st, 10);
        }
        let rcr: i64 = mv_charge(st, nrow * 160);
        if rcr != 0 {
            return rcr;
        }
        let result: i64 = mv_walk_value_rows(buf, len, p10, nrow, 0 - 1, nschema, sch, tab, st);
        if result == 0 {
            if __mind_load_i64(st + 112) == 1 {
                if __mind_load_i64(st + 104) == 0 {
                    __mind_store_i64(st + 112, 0);
                    __mind_store_i64(st + 72, prior_track);
                    return mv_fail(st, 42);
                }
            }
        }
        __mind_store_i64(st + 112, 0);
        __mind_store_i64(st + 72, prior_track);
        return result;
    }

    mv_fail(st, 37)
}

// `n` instructions in sequence at one nesting level.
pub fn mv_walk_instrs(buf: i64, len: i64, pos: i64, n: i64, depth: i64, nstr: i64, nschema: i64, nfunc: i64, tab: i64, sch: i64, fnt: i64, fdef: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, pos);
        return 0;
    }
    let rc: i64 = mv_instr(buf, len, pos, depth, nstr, nschema, nfunc, tab, sch, fnt, fdef, st);
    if rc != 0 {
        return rc;
    }
    let p1: i64 = mv_st_cursor(st);
    mv_walk_instrs(buf, len, p1, n - 1, depth, nstr, nschema, nfunc, tab, sch, fnt, fdef, st)
}

// ---- module next_id and exports -------------------------------------------

// Walk `n` remaining export references. Each is a string index, and the indices
// must be STRICTLY increasing.
//
// The reference collects exports into a set, so a repeated or descending index
// would be absorbed silently on a set round-trip and the body would still
// "mean" the same module. The ordering rule is what makes the encoding
// canonical, so it is checked here on the wire values themselves, before any
// set could hide it.
pub fn mv_walk_exports(buf: i64, len: i64, pos: i64, n: i64, prev: i64, nstr: i64, tab: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, pos);
        return 0;
    }
    let rc: i64 = mv_uleb(buf, len, pos, 0, 0, 1, st);
    if rc != 0 {
        return rc;
    }
    let idx: i64 = mv_st_value(st);
    let p1: i64 = mv_st_cursor(st);
    if prev >= 0 {
        if idx <= prev {
            return mv_fail(st, 35);
        }
    }
    if idx >= nstr {
        return mv_fail(st, 23);
    }
    let rcc: i64 = mv_charge(st, mv_str_len(tab, idx) * 8);
    if rcc != 0 {
        return rcc;
    }
    mv_walk_exports(buf, len, p1, n - 1, idx, nstr, tab, st)
}

// Re-emit `n` export references. Only called after mv_walk_exports admitted the
// same bytes, so every read here is in bounds and the discarded mv_uleb status
// cannot be an error. Without that precondition a failed decode would leave
// st+0 and st+8 stale and this loop would write from garbage.
pub fn mv_emit_exports(inbuf: i64, outbuf: i64, ipos: i64, opos: i64, n: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, ipos);
        return opos;
    }
    mv_uleb(inbuf, ipos + 12, ipos, 0, 0, 1, st);
    let idx: i64 = mv_st_value(st);
    let p1: i64 = mv_st_cursor(st);
    let o1: i64 = mv_put_uleb(outbuf, opos, idx);
    mv_emit_exports(inbuf, outbuf, p1, o1, n - 1, st)
}

// ---- instructions: canonical re-emission -----------------------------------

// Re-emit one ULEB read from `inbuf` at `ipos`. Stores the next input offset at
// st+0 and returns the next output offset. Regenerating rather than copying is
// what makes the comparison meaningful for these fields.
pub fn mv_relay_uleb(inbuf: i64, outbuf: i64, ipos: i64, opos: i64, st: i64) -> i64 {
    mv_uleb(inbuf, ipos + 12, ipos, 0, 0, 1, st);
    let v: i64 = mv_st_value(st);
    mv_put_uleb(outbuf, opos, v)
}

pub fn mv_emit_value_rows(inbuf: i64, outbuf: i64, ipos: i64, opos: i64, n: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, ipos);
        return opos;
    }
    let o1: i64 = mv_relay_uleb(inbuf, outbuf, ipos, opos, st);
    let p1: i64 = mv_st_cursor(st);
    let o2: i64 = mv_emit_type(inbuf, outbuf, p1, o1, st);
    let p2: i64 = mv_st_cursor(st);
    mv_emit_value_rows(inbuf, outbuf, p2, o2, n - 1, st)
}

pub fn mv_emit_named_values(inbuf: i64, outbuf: i64, ipos: i64, opos: i64, n: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, ipos);
        return opos;
    }
    let o1: i64 = mv_relay_uleb(inbuf, outbuf, ipos, opos, st);
    let p1: i64 = mv_st_cursor(st);
    let o2: i64 = mv_relay_uleb(inbuf, outbuf, p1, o1, st);
    let p2: i64 = mv_st_cursor(st);
    mv_emit_named_values(inbuf, outbuf, p2, o2, n - 1, st)
}

pub fn mv_emit_args(inbuf: i64, outbuf: i64, ipos: i64, opos: i64, n: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, ipos);
        return opos;
    }
    let o1: i64 = mv_relay_uleb(inbuf, outbuf, ipos, opos, st);
    let p1: i64 = mv_st_cursor(st);
    mv_emit_args(inbuf, outbuf, p1, o1, n - 1, st)
}

// Re-emit one instruction. Only called after mv_instr admitted the same bytes,
// so every read is in bounds and the opcode is one of the core set.
pub fn mv_emit_instr(inbuf: i64, outbuf: i64, ipos: i64, opos: i64, st: i64) -> i64 {
    let op: i64 = __mind_load_i8(inbuf + ipos);
    __mind_store_i8(outbuf + opos, op);
    if op == 1 {
        let o1: i64 = mv_relay_uleb(inbuf, outbuf, ipos + 1, opos + 1, st);
        let p1: i64 = mv_st_cursor(st);
        return mv_relay_uleb(inbuf, outbuf, p1, o1, st);
    }
    if op == 2 {
        let o1: i64 = mv_relay_uleb(inbuf, outbuf, ipos + 1, opos + 1, st);
        let p1: i64 = mv_st_cursor(st);
        mv_copy(inbuf + p1, outbuf + o1, 8, 0);
        __mind_store_i64(st + 0, p1 + 8);
        return o1 + 8;
    }
    if op == 4 {
        let o1: i64 = mv_relay_uleb(inbuf, outbuf, ipos + 1, opos + 1, st);
        let p1: i64 = mv_st_cursor(st);
        __mind_store_i8(outbuf + o1, __mind_load_i8(inbuf + p1));
        let o2: i64 = mv_relay_uleb(inbuf, outbuf, p1 + 1, o1 + 1, st);
        let p2: i64 = mv_st_cursor(st);
        return mv_relay_uleb(inbuf, outbuf, p2, o2, st);
    }
    if op == 19 {
        return mv_relay_uleb(inbuf, outbuf, ipos + 1, opos + 1, st);
    }
    if op == 23 {
        let tag: i64 = __mind_load_i8(inbuf + ipos + 1);
        __mind_store_i8(outbuf + opos + 1, tag);
        if tag == 0 {
            __mind_store_i64(st + 0, ipos + 2);
            return opos + 2;
        }
        return mv_relay_uleb(inbuf, outbuf, ipos + 2, opos + 2, st);
    }
    if op == 24 {
        let o1: i64 = mv_relay_uleb(inbuf, outbuf, ipos + 1, opos + 1, st);
        let p1: i64 = mv_st_cursor(st);
        let o2: i64 = mv_relay_uleb(inbuf, outbuf, p1, o1, st);
        let p2: i64 = mv_st_cursor(st);
        return mv_relay_uleb(inbuf, outbuf, p2, o2, st);
    }
    if op == 22 {
        let o1: i64 = mv_relay_uleb(inbuf, outbuf, ipos + 1, opos + 1, st);
        let p1: i64 = mv_st_cursor(st);
        let o2: i64 = mv_relay_uleb(inbuf, outbuf, p1, o1, st);
        let p2: i64 = mv_st_cursor(st);
        mv_uleb(inbuf, p2 + 12, p2, 0, 0, 1, st);
        let nargs: i64 = mv_st_value(st);
        let p3: i64 = mv_st_cursor(st);
        let o3: i64 = mv_put_uleb(outbuf, o2, nargs);
        let o4: i64 = mv_emit_args(inbuf, outbuf, p3, o3, nargs, st);
        let p4: i64 = mv_st_cursor(st);
        return mv_relay_uleb(inbuf, outbuf, p4, o4, st);
    }
    // FnDef
    let o1: i64 = mv_relay_uleb(inbuf, outbuf, ipos + 1, opos + 1, st);
    let p1: i64 = mv_st_cursor(st);
    mv_uleb(inbuf, p1 + 12, p1, 0, 0, 1, st);
    let nparam: i64 = mv_st_value(st);
    let p2: i64 = mv_st_cursor(st);
    let o2: i64 = mv_put_uleb(outbuf, o1, nparam);
    let o3: i64 = mv_emit_named_values(inbuf, outbuf, p2, o2, nparam, st);
    let p3: i64 = mv_st_cursor(st);
    let rtag: i64 = __mind_load_i8(inbuf + p3);
    __mind_store_i8(outbuf + o3, rtag);
    let o4: i64 = if rtag == 0 {
        o3 + 1
    } else {
        mv_relay_uleb(inbuf, outbuf, p3 + 1, o3 + 1, st)
    };
    let p4: i64 = if rtag == 0 {
        p3 + 1
    } else {
        mv_st_cursor(st)
    };
    let ftag: i64 = __mind_load_i8(inbuf + p4);
    __mind_store_i8(outbuf + o4, ftag);
    let o5: i64 = if ftag == 0 {
        o4 + 1
    } else {
        o4 + 9
    };
    let p5: i64 = if ftag == 0 {
        p4 + 1
    } else {
        p4 + 9
    };
    if ftag != 0 {
        mv_copy(inbuf + p4 + 1, outbuf + o4 + 1, 8, 0)
    }
    mv_uleb(inbuf, p5 + 12, p5, 0, 0, 1, st);
    let nbody: i64 = mv_st_value(st);
    let p6: i64 = mv_st_cursor(st);
    let o6: i64 = mv_put_uleb(outbuf, o5, nbody);
    let o7: i64 = mv_emit_instrs(inbuf, outbuf, p6, o6, nbody, st);
    let p7: i64 = mv_st_cursor(st);
    let o8: i64 = mv_relay_uleb(inbuf, outbuf, p7, o7, st);
    let p8: i64 = mv_st_cursor(st);
    let o9: i64 = mv_relay_uleb(inbuf, outbuf, p8, o8, st);
    let p9: i64 = mv_st_cursor(st);
    mv_uleb(inbuf, p9 + 12, p9, 0, 0, 1, st);
    let nrow: i64 = mv_st_value(st);
    let p10: i64 = mv_st_cursor(st);
    let o10: i64 = mv_put_uleb(outbuf, o9, nrow);
    mv_emit_value_rows(inbuf, outbuf, p10, o10, nrow, st)
}

pub fn mv_emit_instrs(inbuf: i64, outbuf: i64, ipos: i64, opos: i64, n: i64, st: i64) -> i64 {
    if n <= 0 {
        __mind_store_i64(st + 0, ipos);
        return opos;
    }
    let o1: i64 = mv_emit_instr(inbuf, outbuf, ipos, opos, st);
    let p1: i64 = mv_st_cursor(st);
    mv_emit_instrs(inbuf, outbuf, p1, o1, n - 1, st)
}

// ---- byte comparison ------------------------------------------------------

pub fn mv_equal(a: i64, b: i64, n: i64, i: i64) -> i64 {
    if i >= n {
        return 1;
    }
    if __mind_load_i8(a + i) != __mind_load_i8(b + i) {
        return 0;
    }
    mv_equal(a, b, n, i + 1)
}

// ---- argv ----------------------------------------------------------------

// Does argv[i] equal "--dump"? Compared byte by byte against a NUL terminator.
pub fn mv_is_dump(p: i64) -> i64 {
    if __mind_load_i8(p + 0) != 45 {
        return 0;
    }
    if __mind_load_i8(p + 1) != 45 {
        return 0;
    }
    if __mind_load_i8(p + 2) != 100 {
        return 0;
    }
    if __mind_load_i8(p + 3) != 117 {
        return 0;
    }
    if __mind_load_i8(p + 4) != 109 {
        return 0;
    }
    if __mind_load_i8(p + 5) != 112 {
        return 0;
    }
    if __mind_load_i8(p + 6) != 0 {
        return 0;
    }
    1
}

// ---- driver ---------------------------------------------------------------

pub fn main() -> i64 {
    if __mind_argc() < 2 {
        return 2;
    }
    let fd: i64 = __mind_open(__mind_argv(1));
    if fd < 0 {
        return 3;
    }

    let cap: i64 = mv_max_input() + 2;
    let inbuf: i64 = __mind_alloc(cap + 16);
    let len: i64 = mv_read_all(fd, inbuf, cap, 0);

    // Oversize is decided before any decoding, exactly as the reference does.
    if len > mv_max_input() {
        return 17;
    }

    let st: i64 = __mind_alloc(8448);
    __mind_store_i64(st + 40, 0);
    __mind_store_i64(st + 48, 0);
    __mind_store_i64(st + 64, 0);
    __mind_store_i64(st + 72, 0);
    __mind_store_i64(st + 120, 0);
    __mind_store_i64(st + 128, 0);

    // --- header ---
    if len < 4 {
        return 10;
    }
    if __mind_load_i8(inbuf + 0) != 77 {
        return 11;
    }
    if __mind_load_i8(inbuf + 1) != 73 {
        return 11;
    }
    if __mind_load_i8(inbuf + 2) != 67 {
        return 11;
    }
    if __mind_load_i8(inbuf + 3) != 51 {
        return 11;
    }
    if len < 5 {
        return 10;
    }
    if __mind_load_i8(inbuf + 4) != 4 {
        return 12;
    }

    // --- required-surface bits ---
    let rc1: i64 = mv_uleb(inbuf, len, 5, 0, 0, 1, st);
    if rc1 != 0 {
        return rc1;
    }
    let surface: i64 = mv_st_value(st);
    let after_surface: i64 = mv_st_cursor(st);
    // KNOWN_SURFACE_BITS is REQUIRED_STD_SURFACE only, i.e. bit 0.
    if surface > 1 {
        return 15;
    }
    if surface == 1 {
        return 16;
    }

    // --- allocation budget, mirroring min(128 MiB, 1 MiB + 32 * input) ---
    let raw_budget: i64 = mv_budget_base() + 32 * len;
    let budget0: i64 = if raw_budget > mv_budget_cap() {
        mv_budget_cap()
    } else {
        raw_budget
    };

    // --- string table ---
    let rc2: i64 = mv_uleb(inbuf, len, after_surface, 0, 0, 1, st);
    if rc2 != 0 {
        return rc2;
    }
    let count: i64 = mv_st_value(st);
    let table_start: i64 = mv_st_cursor(st);
    // The reference refuses a count that cannot fit in the remaining bytes
    // before allocating anything for it.
    if count > len - table_start {
        return 10;
    }
    let budget1: i64 = budget0 - count * 32;
    if budget1 < 0 {
        return 22;
    }
    // Declared narrowing: every entry costs at least one length byte, so a table
    // larger than the admitted prefix cannot fit in a prefix this mirror will
    // accept. Refusing it here bounds the index table before it is allocated.
    if count > mv_max_prefix() {
        return 17;
    }
    let tab: i64 = __mind_alloc(16 * count + 16);
    let rc3: i64 = mv_walk_strings(inbuf, len, table_start, count, 0, 0 - 1, budget1, tab, 0, st);
    if rc3 != 0 {
        return rc3;
    }
    let after_strings: i64 = mv_st_cursor(st);

    // --- schema identity headers ---
    let rc4: i64 = mv_uleb(inbuf, len, after_strings, 0, 0, 1, st);
    if rc4 != 0 {
        return rc4;
    }
    let nschema: i64 = mv_st_value(st);
    let sch_start: i64 = mv_st_cursor(st);
    if nschema > len - sch_start {
        return 10;
    }
    if nschema > mv_max_prefix() {
        return 17;
    }
    let rc5: i64 = mv_charge(st, nschema * 256);
    if rc5 != 0 {
        return rc5;
    }
    let sch: i64 = __mind_alloc(16 * nschema + 16);
    let fld: i64 = __mind_alloc(8 * mv_max_prefix() + 16);
    let rc6: i64 = mv_walk_schema_headers(inbuf, len, sch_start, nschema, 0 - 1, 0 - 1, count, tab, sch, 0, st);
    if rc6 != 0 {
        return rc6;
    }
    let bodies_start: i64 = mv_st_cursor(st);

    // --- schema field lists ---
    let rc7: i64 = mv_walk_schemas(inbuf, len, bodies_start, nschema, count, nschema, tab, sch, fld, st);
    if rc7 != 0 {
        return rc7;
    }
    let after_schemas: i64 = mv_st_cursor(st);

    // --- function declarations ---
    let rc8: i64 = mv_uleb(inbuf, len, after_schemas, 0, 0, 1, st);
    if rc8 != 0 {
        return rc8;
    }
    let nfunc: i64 = mv_st_value(st);
    let fn_start: i64 = mv_st_cursor(st);
    if nfunc > len - fn_start {
        return 10;
    }
    let rc9: i64 = mv_charge(st, nfunc * 320);
    if rc9 != 0 {
        return rc9;
    }
    let fnt: i64 = __mind_alloc(56 * nfunc + 16);
    // Cleared explicitly: __mind_alloc does not zero, and this table is read
    // through a decoded index before it is otherwise written.
    let fdef: i64 = __mind_alloc(8 * nfunc + 16);
    mv_zero(fdef, nfunc + 1, 0);
    let rc10: i64 = mv_walk_functions(inbuf, len, fn_start, nfunc, 0 - 1, 0 - 1, count, nschema, tab, sch, fnt, 0, st);
    if rc10 != 0 {
        return rc10;
    }
    let after_functions: i64 = mv_st_cursor(st);

    // --- module next_id ---
    let rc11: i64 = mv_uleb(inbuf, len, after_functions, 0, 0, 1, st);
    if rc11 != 0 {
        return rc11;
    }
    let next_id: i64 = mv_st_value(st);
    let after_next_id: i64 = mv_st_cursor(st);

    // --- exports ---
    let rc12: i64 = mv_uleb(inbuf, len, after_next_id, 0, 0, 1, st);
    if rc12 != 0 {
        return rc12;
    }
    let nexport: i64 = mv_st_value(st);
    let ex_start: i64 = mv_st_cursor(st);
    if nexport > len - ex_start {
        return 10;
    }
    let rc13: i64 = mv_charge(st, nexport * 32);
    if rc13 != 0 {
        return rc13;
    }
    let rc14: i64 = mv_walk_exports(inbuf, len, ex_start, nexport, 0 - 1, count, tab, st);
    if rc14 != 0 {
        return rc14;
    }
    let after_exports: i64 = mv_st_cursor(st);

    // --- module instruction list ---
    let rc15: i64 = mv_uleb(inbuf, len, after_exports, 0, 0, 1, st);
    if rc15 != 0 {
        return rc15;
    }
    let ninstr: i64 = mv_st_value(st);
    let instr_start: i64 = mv_st_cursor(st);
    if ninstr > len - instr_start {
        return 10;
    }
    let rc16: i64 = mv_charge(st, ninstr * 320);
    if rc16 != 0 {
        return rc16;
    }
    // Only the module instruction stream contributes to the module next_id
    // bound. FnDef switches this flag off while decoding its independent
    // declaration/body namespace and restores it on successful completion.
    __mind_store_i64(st + 72, 1);
    let rc17: i64 = mv_walk_instrs(inbuf, len, instr_start, ninstr, 0, count, nschema, nfunc, tab, sch, fnt, fdef, st);
    if rc17 != 0 {
        return rc17;
    }
    let after_instrs: i64 = mv_st_cursor(st);

    // --- four reserved compatibility counts, all required to be zero ---
    let rc18: i64 = mv_reserved_zero(inbuf, len, after_instrs, st);
    if rc18 != 0 {
        return rc18;
    }
    let z1: i64 = mv_st_cursor(st);
    let rc19: i64 = mv_reserved_zero(inbuf, len, z1, st);
    if rc19 != 0 {
        return rc19;
    }
    let z2: i64 = mv_st_cursor(st);
    let rc20: i64 = mv_reserved_zero(inbuf, len, z2, st);
    if rc20 != 0 {
        return rc20;
    }
    let z3: i64 = mv_st_cursor(st);
    let rc21: i64 = mv_reserved_zero(inbuf, len, z3, st);
    if rc21 != 0 {
        return rc21;
    }
    let z4: i64 = mv_st_cursor(st);

    // --- module semantic value rows ---
    // Module rows are part of the same scope as the top-level instruction
    // operands, so mv_vid records them while the module tracking flag remains
    // enabled. The reference performs this check before canonical metadata
    // verification and before canonical re-emission.
    let rc22: i64 = mv_uleb(inbuf, len, z4, 0, 0, 1, st);
    if rc22 != 0 {
        return rc22;
    }
    let nrow: i64 = mv_st_value(st);
    let row_start: i64 = mv_st_cursor(st);
    if nrow > len - row_start {
        return 10;
    }
    let rc23: i64 = mv_charge(st, nrow * 160);
    if rc23 != 0 {
        return rc23;
    }
    let rc24: i64 = mv_walk_value_rows(inbuf, len, row_start, nrow, 0 - 1, nschema, sch, tab, st);
    if rc24 != 0 {
        return rc24;
    }
    if next_id < __mind_load_i64(st + 64) {
        return mv_fail(st, 41);
    }
    let prefix_len: i64 = mv_st_cursor(st);
    if prefix_len > mv_max_prefix() {
        return 17;
    }

    // --- checked canonical re-emission of exactly the consumed prefix ---
    let outbuf: i64 = __mind_alloc(mv_max_prefix() + 16);
    __mind_store_i8(outbuf + 0, 77);
    __mind_store_i8(outbuf + 1, 73);
    __mind_store_i8(outbuf + 2, 67);
    __mind_store_i8(outbuf + 3, 51);
    __mind_store_i8(outbuf + 4, 4);
    let o1: i64 = mv_put_uleb(outbuf, 5, surface);
    let o2: i64 = mv_put_uleb(outbuf, o1, count);
    let o3: i64 = mv_emit_strings(inbuf, outbuf, table_start, o2, count, st);
    let o4: i64 = mv_put_uleb(outbuf, o3, nschema);
    let o5: i64 = mv_emit_schema_headers(inbuf, outbuf, sch_start, o4, nschema, st);
    let hdr_end: i64 = mv_st_cursor(st);
    let o6: i64 = mv_emit_schema_bodies(inbuf, outbuf, hdr_end, o5, nschema, st);
    let o7: i64 = mv_put_uleb(outbuf, o6, nfunc);
    let o8: i64 = mv_emit_functions(inbuf, outbuf, fn_start, o7, nfunc, st);
    let o9: i64 = mv_put_uleb(outbuf, o8, next_id);
    let o10: i64 = mv_put_uleb(outbuf, o9, nexport);
    let o11: i64 = mv_emit_exports(inbuf, outbuf, ex_start, o10, nexport, st);
    let o12: i64 = mv_put_uleb(outbuf, o11, ninstr);
    let o13: i64 = mv_emit_instrs(inbuf, outbuf, instr_start, o12, ninstr, st);
    let o14: i64 = mv_put_uleb(outbuf, o13, 0);
    let o15: i64 = mv_put_uleb(outbuf, o14, 0);
    let o16: i64 = mv_put_uleb(outbuf, o15, 0);
    let o17: i64 = mv_put_uleb(outbuf, o16, 0);
    let o18: i64 = mv_put_uleb(outbuf, o17, nrow);
    let o19: i64 = mv_emit_value_rows(inbuf, outbuf, row_start, o18, nrow, st);

    if o19 != prefix_len {
        return 18;
    }
    if mv_equal(inbuf, outbuf, prefix_len, 0) == 0 {
        return 18;
    }

    // The re-emitted bytes are offered to the caller so the byte comparison can
    // be redone outside this process rather than taken on its word.
    if __mind_argc() > 2 {
        if mv_is_dump(__mind_argv(2)) == 1 {
            __mind_write(1, outbuf, o19, 0 - 1)
        }
    }

    // Anything past the declared prefix is refused, never silently accepted.
    if prefix_len != len {
        return 20;
    }
    0
}
