// NEGATIVE fixture for E_NERVE_002 (numerics.md@v1 §6 rule 2).
// A left-to-right accumulate with no declared schedule: a backend is free to
// reassociate it and the result changes in the last bit.
#[determinism(BitIdentical)]
fn unsafe_sum(x: i64) -> i64 {
    let mut acc: i64 = x
    for i in 0..8 {
        acc = acc + i
    }
    return acc
}
