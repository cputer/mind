// NEGATIVE fixture for E_NERVE_005 (numerics.md@v1 §2, §6 rule 5).
// A backend-provided reduction has implementation-defined associativity, so it
// is rejected even though the caller declares a strategy tag: the tag describes
// the caller's fold, not the callee's.
extern "C" {
    fn reduce_sum(x: i64) -> i64
}

#[determinism(BitIdentical)]
#[reduction_strategy(sequential)]
fn total(x: i64) -> i64 {
    return reduce_sum(x)
}
